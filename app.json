{
  "expo": {
    "name": "CityFix",
    "slug": "CityFix",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/cityfix-logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.rensithudara.cityfix",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/cityfix-logo.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/cityfix-logo.png"
    },
    "scheme": "cityfix",
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow CityFix to photograph local issues.",
          "photosPermission": "Allow CityFix to attach photos to your reports.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow CityFix to locate the issue you are reporting."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/cityfix-logo.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "a18826ae-73d5-4662-ad88-1beb426532c9"
      }
    },
    "owner": "rensithudara"
  }
}
