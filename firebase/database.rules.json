{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "sessions": {
          "$session": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['connectedAt'])",
            "connectedAt": { ".validate": "newData.isNumber() && newData.val() <= now" },
            "$other": { ".validate": false }
          }
        }
      }
    }
  }
}
