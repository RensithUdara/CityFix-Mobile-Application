rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() { return signedIn() && request.auth.token.admin == true; }
    match /users/{uid} {
      allow read: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'neighborhood', 'createdAt'])
        && request.resource.data.displayName is string && request.resource.data.displayName.size() >= 2 && request.resource.data.displayName.size() <= 80
        && request.resource.data.neighborhood is string && request.resource.data.neighborhood.size() <= 160;
      match /follows/{issueId} {
        allow read, delete: if owner(uid);
        allow create: if owner(uid) && exists(/databases/$(database)/documents/issues/$(issueId))
          && request.resource.data.keys().hasOnly(['createdAt']) && request.resource.data.createdAt == request.time;
      }
    }
    match /issues/{issueId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['title', 'description', 'category', 'severity', 'address', 'latitude', 'longitude', 'image', 'imagePath', 'ownerId', 'status', 'confirmedBy', 'createdAt', 'updatedAt'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() >= 5 && request.resource.data.title.size() <= 90
        && request.resource.data.description is string && request.resource.data.description.size() >= 15 && request.resource.data.description.size() <= 5000
        && request.resource.data.address is string && request.resource.data.address.size() >= 5 && request.resource.data.address.size() <= 300
        && request.resource.data.category in ['Roads', 'Lighting', 'Waste', 'Water', 'Public spaces']
        && request.resource.data.severity in ['Low', 'Medium', 'High']
        && request.resource.data.status == 'Reported'
        && request.resource.data.confirmedBy == {}
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && ((request.resource.data.latitude == null && request.resource.data.longitude == null) ||
          (request.resource.data.latitude is number && request.resource.data.latitude >= -90 && request.resource.data.latitude <= 90 && request.resource.data.longitude is number && request.resource.data.longitude >= -180 && request.resource.data.longitude <= 180))
        && ((request.resource.data.image == null && request.resource.data.imagePath == null) ||
          (request.resource.data.image is string && request.resource.data.image.matches('https://firebasestorage.googleapis.com/.*') && request.resource.data.imagePath == 'issues/' + request.auth.uid + '/' + issueId + '/photo'));
      allow update: if signedIn() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirmedBy'])
          && request.resource.data.confirmedBy is map
          && request.resource.data.confirmedBy.diff(resource.data.confirmedBy).affectedKeys().hasOnly([request.auth.uid])
          && (!(request.auth.uid in request.resource.data.confirmedBy) || request.resource.data.confirmedBy[request.auth.uid] == true))
        || (admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status in ['Reported', 'In progress', 'Resolved'] && request.resource.data.updatedAt == request.time));
      allow delete: if admin();
    }
  }
}
