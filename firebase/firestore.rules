rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function admin() { return signedIn() && exists(/databases/$(database)/documents/admin/$(request.auth.uid)) && get(/databases/$(database)/documents/admin/$(request.auth.uid)).data.active == true; }
    function validPhoto(photos, index, issueId) {
      return photos.size() <= index || (photos[index].keys().hasOnly(['url', 'path'])
        && photos[index].url is string && photos[index].url.matches('https://firebasestorage.googleapis.com/.*')
        && photos[index].path == 'issues/' + request.auth.uid + '/' + issueId + '/photo-' + string(index) + '.jpg');
    }
    match /admin/{uid} { allow read: if owner(uid); }
    match /webhooks/{id} { allow read: if admin(); }
    match /webhookDeliveries/{id} { allow read: if admin(); }
    match /users/{uid} {
      allow read: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'neighborhood', 'createdAt'])
        && request.resource.data.displayName is string && request.resource.data.displayName.size() >= 2 && request.resource.data.displayName.size() <= 80
        && request.resource.data.neighborhood is string && request.resource.data.neighborhood.size() <= 160;
      match /follows/{issueId} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid) && existsAfter(/databases/$(database)/documents/issues/$(issueId))
          && request.resource.data.keys().hasOnly(['createdAt', 'issueId', 'statusUpdates', 'commentUpdates'])
          && request.resource.data.issueId == issueId && request.resource.data.statusUpdates is bool && request.resource.data.commentUpdates is bool
          && request.resource.data.createdAt is timestamp;
      }
      match /pushTokens/{deviceId} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid) && request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt'])
          && request.resource.data.token is string && request.resource.data.token.size() <= 250
          && request.resource.data.token.matches('(ExponentPushToken|ExpoPushToken)\\[.*\\]')
          && request.resource.data.platform in ['ios', 'android'] && request.resource.data.updatedAt == request.time;
      }
      match /notifications/{id} {
        allow read: if owner(uid);
        allow update: if owner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) && request.resource.data.read is bool;
        allow delete: if owner(uid);
      }
      match /achievements/{id} { allow read: if owner(uid); }
      match /apiKeys/{id} { allow read: if owner(uid); }
      match /preferences/app {
        allow read: if owner(uid);
        allow create, update: if owner(uid) && request.resource.data.keys().hasOnly(['autoFollow', 'showResolved', 'defaultSeverity'])
          && request.resource.data.autoFollow is bool && request.resource.data.showResolved is bool && request.resource.data.defaultSeverity in ['Low', 'Medium', 'High'];
      }
      match /supportRequests/{id} {
        allow read: if owner(uid);
        allow create: if owner(uid) && request.resource.data.keys().hasOnly(['subject', 'message', 'createdAt', 'status'])
          && request.resource.data.subject is string && request.resource.data.subject.size() >= 3 && request.resource.data.subject.size() <= 100
          && request.resource.data.message is string && request.resource.data.message.size() >= 10 && request.resource.data.message.size() <= 3000
          && request.resource.data.status == 'Received' && request.resource.data.createdAt == request.time;
      }
    }
    match /analytics/{id} { allow read: if signedIn(); }
    match /moderationFlags/{id} { allow read: if admin(); }
    match /moderationAudit/{id} { allow read: if admin(); }
    match /issues/{issueId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['title', 'description', 'category', 'severity', 'address', 'latitude', 'longitude', 'image', 'imagePath', 'photos', 'ownerId', 'status', 'confirmedBy', 'createdAt', 'updatedAt'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() >= 5 && request.resource.data.title.size() <= 90
        && request.resource.data.description is string && request.resource.data.description.size() >= 15 && request.resource.data.description.size() <= 5000
        && request.resource.data.address is string && request.resource.data.address.size() >= 5 && request.resource.data.address.size() <= 300
        && request.resource.data.category in ['Roads', 'Lighting', 'Waste', 'Water', 'Public spaces']
        && request.resource.data.severity in ['Low', 'Medium', 'High']
        && request.resource.data.status == 'Reported'
        && request.resource.data.confirmedBy == {}
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && ((request.resource.data.latitude == null && request.resource.data.longitude == null) ||
          (request.resource.data.latitude is number && request.resource.data.latitude >= -90 && request.resource.data.latitude <= 90 && request.resource.data.longitude is number && request.resource.data.longitude >= -180 && request.resource.data.longitude <= 180))
        && request.resource.data.photos is list && request.resource.data.photos.size() >= 1 && request.resource.data.photos.size() <= 5
        && validPhoto(request.resource.data.photos, 0, issueId) && validPhoto(request.resource.data.photos, 1, issueId)
        && validPhoto(request.resource.data.photos, 2, issueId) && validPhoto(request.resource.data.photos, 3, issueId) && validPhoto(request.resource.data.photos, 4, issueId)
        && request.resource.data.image == request.resource.data.photos[0].url && request.resource.data.imagePath == request.resource.data.photos[0].path;
      allow update: if signedIn() && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['confirmedBy'])
          && request.resource.data.confirmedBy is map
          && request.resource.data.confirmedBy.diff(resource.data.confirmedBy).affectedKeys().hasOnly([request.auth.uid])
          && (!(request.auth.uid in request.resource.data.confirmedBy) || request.resource.data.confirmedBy[request.auth.uid] == true))
        || (admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status in ['Reported', 'In progress', 'Resolved'] && request.resource.data.updatedAt == request.time));
      allow delete: if admin();
      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() && exists(/databases/$(database)/documents/issues/$(issueId))
          && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'body', 'createdAt'])
          && request.resource.data.authorId == request.auth.uid && request.resource.data.authorName is string && request.resource.data.authorName.size() <= 80
          && request.resource.data.body is string && request.resource.data.body.size() >= 2 && request.resource.data.body.size() <= 1000
          && request.resource.data.createdAt == request.time;
        allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
      }
    }
  }
}
